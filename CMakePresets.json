{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "debug-with-tests",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-tests",
      "cacheVariables": { "BUILD_TESTS": "ON" }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "release-with-tests",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/release-tests",
      "cacheVariables": { "BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-with-tests", "configurePreset": "debug-with-tests" },
    { "name": "release", "configurePreset": "release" },
    { "name": "release-with-tests", "configurePreset": "release-with-tests" }
  ],
  "testPresets": [
    {
      "name": "debug-with-tests",
      "configurePreset": "debug-with-tests",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-with-tests",
      "configurePreset": "release-with-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
